{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window. http:default allows https everywhere (minus the private-range denies) plus http on loopback, which exists only for local MCP servers and is re-checked in TS on every request (src/lib/mcp.ts). opener:allow-open-url is scoped by *scheme*, not host: an agent cites arbitrary URLs in chat markdown, so a host allowlist can only ever be an incomplete list of dead links. Limiting it to http(s) is the boundary that matters, since it excludes file:, javascript: and custom app schemes that can act on the machine; openExternal re-checks the scheme in TS (src/lib/tauri.ts).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://localhost:*/**"
        }
      ],
      "deny": [
        {
          "url": "https://localhost/**"
        },
        {
          "url": "https://localhost:*/**"
        },
        {
          "url": "https://:private(127\\.[0-9]+\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(127\\.[0-9]+\\.[0-9]+\\.[0-9]+):*/**"
        },
        {
          "url": "https://:private(0\\.0\\.0\\.0)/**"
        },
        {
          "url": "https://:private(0\\.0\\.0\\.0):*/**"
        },
        {
          "url": "https://[*]:*/**"
        },
        {
          "url": "https://*.local/**"
        },
        {
          "url": "https://*.local:*/**"
        },
        {
          "url": "https://:private(10\\.[0-9]+\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(10\\.[0-9]+\\.[0-9]+\\.[0-9]+):*/**"
        },
        {
          "url": "https://:private(172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]+\\.[0-9]+):*/**"
        },
        {
          "url": "https://:private(192\\.168\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(192\\.168\\.[0-9]+\\.[0-9]+):*/**"
        },
        {
          "url": "https://:private(169\\.254\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(169\\.254\\.[0-9]+\\.[0-9]+):*/**"
        },
        {
          "url": "https://:private(100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]+\\.[0-9]+)/**"
        },
        {
          "url": "https://:private(100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]+\\.[0-9]+):*/**"
        }
      ]
    }
  ]
}
